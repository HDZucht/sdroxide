From e158dd8b8823cb90bb7412a876ce1ca957ede812 Mon Sep 17 00:00:00 2001
From: Hans-Dieter Zucht <hd.zucht@googlemail.com>
Date: Fri, 6 Nov 2026 13:18:34 +0100
Subject: [PATCH] FT8: keep the action row (CALL CQ, STOP QSO, STOP TX) inside
 the window
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The row is laid out bottom-up and was placed by interact_size.y, shorter
than its chips, so the difference hung off the bottom edge: 10 pt on a
desktop, 6 pt on a tablet. Start the row at the chip height.

Hans-Dieter Zucht (@HDZucht) and Aletheia (616a403f) (Claude Opus 5.5) — code suggestion with Claude Code

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/sdroxide-ui/src/app/frame.rs          | 67 ++++++++++++++++++++
 crates/sdroxide-ui/src/app/panels/decodes.rs | 14 ++++
 2 files changed, 81 insertions(+)

diff --git a/crates/sdroxide-ui/src/app/frame.rs b/crates/sdroxide-ui/src/app/frame.rs
index 9d489a2e..293e907d 100644
--- a/crates/sdroxide-ui/src/app/frame.rs
+++ b/crates/sdroxide-ui/src/app/frame.rs
@@ -2152,4 +2152,71 @@ mod tests {
         assert!(panel <= 0.6 * 279.0 + 0.01, "floor {panel} ate the waterfall");
         assert!(wf > 0.0);
     }
+
+    /// A controller with nothing behind it: enough to draw the whole app.
+    struct NullCtrl;
+    impl sdroxide_types::RadioController for NullCtrl {
+        fn send(&mut self, _cmd: sdroxide_types::Command) {}
+        fn poll_event(&mut self) -> Option<sdroxide_types::RadioEvent> {
+            None
+        }
+    }
+
+    /// The FT8 action row (CALL CQ, STOP QSO, STOP TX) and the panel's frame
+    /// end inside the window. The row is laid out bottom-up and was placed by
+    /// the style's row height, shorter than its chips, so the difference hung
+    /// off the bottom: 10 points on a desktop, 6 on a tablet, at every window
+    /// size. Drawn here as the whole app, because the overhang came from how
+    /// the pieces sit inside each other and no one piece shows it alone.
+    ///
+    /// Ignored in the normal run: the app sets the language, the look and the
+    /// map switches process-wide, and the tests beside it read those. Run it
+    /// alone: `cargo test -p sdroxide-ui --lib the_ft8_action_row -- --ignored`.
+    #[test]
+    #[ignore = "draws the whole app, which changes process-wide settings"]
+    fn the_ft8_action_row_ends_inside_the_window() {
+        use eframe::egui;
+        use sdroxide_types::LayoutMode;
+        let mut over = Vec::new();
+        for layout in [LayoutMode::Desktop, LayoutMode::Tablet] {
+            for (w, h) in
+                [(1290.0f32, 724.0f32), (1366.0, 768.0), (1633.0, 965.0), (1920.0, 1050.0)]
+            {
+                let ctx = egui::Context::default();
+                let mut app = crate::app::SdroxideApp::new_tab(
+                    &ctx,
+                    None,
+                    None,
+                    Box::new(NullCtrl),
+                    0,
+                    false,
+                );
+                app.ui_settings.layout = layout;
+                app.state.rx[0].mode = Mode::Ft8;
+                let mut frame = eframe::Frame::_new_kittest();
+                let screen = egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(w, h));
+                // A few frames: the tier and its metrics settle on the first.
+                let mut lowest = 0.0f32;
+                for _ in 0..4 {
+                    let mut out = ctx.run_ui(
+                        egui::RawInput { screen_rect: Some(screen), ..Default::default() },
+                        |ui| eframe::App::ui(&mut app, ui, &mut frame),
+                    );
+                    out.textures_delta.clear();
+                    lowest = out
+                        .shapes
+                        .iter()
+                        .map(|c| c.shape.visual_bounding_rect())
+                        .filter(|r| r.is_finite())
+                        .map(|r| r.bottom())
+                        .fold(0.0, f32::max);
+                }
+                // One point of slack for the anti-aliased edge of the frame.
+                if lowest > h + 1.0 {
+                    over.push(format!("{layout:?} {w}x{h}: drawn down to {lowest}"));
+                }
+            }
+        }
+        assert!(over.is_empty(), "{over:#?}");
+    }
 }
diff --git a/crates/sdroxide-ui/src/app/panels/decodes.rs b/crates/sdroxide-ui/src/app/panels/decodes.rs
index a3889a96..9dc362fb 100644
--- a/crates/sdroxide-ui/src/app/panels/decodes.rs
+++ b/crates/sdroxide-ui/src/app/panels/decodes.rs
@@ -1500,7 +1500,20 @@ impl SdroxideApp {
         // a transmitter: STOP QSO and STOP TX stay live, because a stop is
         // worth having even where it should have nothing to stop.
         let tx_ok = self.tx_capable();
+        // A bottom-up layout places a row by the height it is *started* with,
+        // which for `horizontal_wrapped` is `interact_size.y`, and the row then
+        // grows downward to fit what is in it. These chips are taller than that
+        // (29 points against 18 on a desktop, 41 against 34 on a tablet), so
+        // the difference hung off the bottom edge of the column and took the
+        // panel's frame and the lower part of the buttons with it. Started at
+        // the chips' own height, the row sits on the edge instead of below it.
+        let row_h = crate::chrome::chip_height(ui, Some(15.0));
+        let interact_h = ui.spacing().interact_size.y;
+        ui.spacing_mut().interact_size.y = interact_h.max(row_h);
         ui.horizontal_wrapped(|ui| {
+            // Back to the style's own height inside the row, so nothing drawn
+            // in it is sized from the row's.
+            ui.spacing_mut().interact_size.y = interact_h;
             let cq = ui.add_enabled_ui(!in_qso && tx_ok, |ui| {
                 rx_only_hint(
                     crate::chrome::chip_accent(
@@ -1533,6 +1546,7 @@ impl SdroxideApp {
                 cmds.push(Command::DigiAbortTx);
             }
         });
+        ui.spacing_mut().interact_size.y = interact_h;
         ui.add_space(gap);
         // Message picker: choose by hand which message goes next (WSJT-X's
         // Tx1–Tx6), or send a line of free text in the next slot.
-- 
